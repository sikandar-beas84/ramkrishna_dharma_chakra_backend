<IfModule mod_rewrite.c>

    RewriteEngine On

    # IMPORTANT:
    # Do not execute public/admin/index.php.
    # Send Laravel admin application routes to the main Laravel front controller.

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ ../index.php [L]

</IfModule>